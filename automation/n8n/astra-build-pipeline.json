      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Parse the headless planner run and stage everything Tristen needs at Gate 1.\nconst run = JSON.parse($input.first().json.stdout);\nif (run.is_error) {\n  throw new Error('Planner run failed: ' + String(run.result || '').slice(0, 2000));\n}\nconst item = JSON.parse($('Pick next item').first().json.stdout);\nreturn [{ json: {\n  item,\n  planner_session: run.session_id,\n  planner_cost_usd: run.total_cost_usd,\n  planner_report: run.result,\n  gate1_resume_url: $execution.resumeUrl,\n  gate1_instructions: 'Step ' + item.id + ' (' + item.feature + ') covers ' + item.covers.map(c => c.id).join(', ') + '. Read docs/feature_plans/' + item.branch + '.md on branch ' + item.branch + '. To approve the plan and start the builder, open gate1_resume_url. To reject, cancel this execution.'\n} }];"
      }
    },
    {
      "id": "a1a1a1a1-0005-4000-8000-000000000005",
      "name": "Gate 1 — plan approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
