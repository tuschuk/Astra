    },
    {
      "id": "a1a1a1a1-0007-4000-8000-000000000007",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// Combine both runs into the Gate 2 hand-over: what was built, what it cost, what to do next.\nconst run = JSON.parse($input.first().json.stdout);\nconst staged = $('Check planner result').first().json;\nif (run.is_error) {\n  throw new Error('Builder run failed after retry: ' + String(run.result || '').slice(0, 2000));\n}\nreturn [{ json: {\n  item: staged.item.id,\n  feature: staged.item.feature,\n  branch: staged.item.branch,\n  builder_report: run.result,\n  sessions: { planner: staged.planner_session, builder: run.session_id },\n  cost_usd: { planner: staged.planner_cost_usd || 0, builder: run.total_cost_usd || 0, total: (staged.planner_cost_usd || 0) + (run.total_cost_usd || 0) },\n  gate2: 'Review branch ' + staged.item.branch + ', merge to main, then in docs/BUILD_LIST.md flip step ' + staged.item.id + ' to Built and update the Status of ' + staged.item.covers.map(c => c.id).join(', ') + ' as their definitions of done become true.'\n} }];"
      }
    }
  ],
