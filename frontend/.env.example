# Copy to frontend/.env (never committed) and fill in the real values.
# Both come from the Supabase dashboard → Project Settings → API, or from the
# Supabase MCP tools get_project_url / get_publishable_keys.
# The publishable (anon) key is safe to ship in the app: row-level security
# in the database is what protects data, not this key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
