{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The shared training-math module (backend/supabase/functions/_shared/training-math) spells
    // out `.ts` in its imports because Supabase's Deno runtime requires it.
    "allowImportingTsExtensions": true,
    // `@training-math` is the app's one import name for that module (also mapped in
    // metro.config.js and jest.config.js). `@jest/globals` is mapped so the module's tests,
    // which live outside frontend/, still find Jest's types in frontend/node_modules.
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@training-math": [
        "../backend/supabase/functions/_shared/training-math/index.ts"
      ],
      // `@analysis` — the post-workout analysis rules (B18), shared with the analyze-workout
      // server function the same way.
      "@analysis": [
        "../backend/supabase/functions/_shared/analysis/index.ts"
      ],
      "@jest/globals": [
        "./node_modules/@jest/globals"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../backend/supabase/functions/_shared/training-math/**/*.ts",
    "../backend/supabase/functions/_shared/analysis/**/*.ts",
    // The analyze-workout function's request logic and its tests. Its index.ts is left out on
    // purpose: it is Deno-only wiring (Deno.serve, an npm: import) that this compiler can't see.
    "../backend/supabase/functions/analyze-workout/handler.ts",
    "../backend/supabase/functions/tests/**/*.ts"
  ]
}
